# Server Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=*

# Database
DATABASE_URL=postgresql://topupuser:topuppass123@localhost:5432/topupdb
DB_PASSWORD=topuppass123

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# WhatsApp Bot
WHATSAPP_SESSION_PATH=./whatsapp-session

# Supplier API (e.g., VIP Reseller, Digiflazz, etc.)
SUPPLIER_API_URL=https://api.supplier.com/v1
SUPPLIER_API_KEY=your-supplier-api-key
SUPPLIER_API_SECRET=your-supplier-api-secret

# Payment Gateway (e.g., Tripay, Midtrans, etc.)
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com/v1
PAYMENT_GATEWAY_KEY=your-payment-gateway-merchant-key
PAYMENT_WEBHOOK_SECRET=your-webhook-signature-secret

# Optional: Logging
LOG_LEVEL=info
