# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bottopup"

# API Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d

# Discord Bot
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Telegram Bot
TELEGRAM_TOKEN=

# WhatsApp (using Twilio as fallback)
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER=+1234567890

# Supplier API (Generic pattern - adjust for your actual supplier)
SUPPLIER_API_BASE_URL=https://api.supplier.example.com
SUPPLIER_API_KEY=
SUPPLIER_API_SECRET=

# Payment Gateway (Generic pattern - e.g., Midtrans, Doku, etc.)
PAYMENT_GATEWAY_API_BASE_URL=https://api.payment.example.com
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_MERCHANT_ID=

# Logging
LOG_LEVEL=info

# Features
ENABLE_AUTO_REFUND=true
ENABLE_TIER_CALCULATION=true
TIER_CALCULATION_DAY_OF_MONTH=1

# Tier thresholds (IDR)
TIER_BRONZE_MIN=0
TIER_BRONZE_MAX=5000000
TIER_SILVER_MIN=5000000
TIER_SILVER_MAX=20000000
TIER_GOLD_MIN=20000000
TIER_GOLD_MAX=999999999999

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Webhook retry config
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=1000
